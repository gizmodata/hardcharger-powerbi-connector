// PreRenameCompat.pqm — names from before the protocol was renamed to Chargewire.
// Hardcharger servers released before the rename mount the protocol under
// another base path and discovery name; ProtocolRoot in Hardcharger.pq uses
// them when a server has no Chargewire discovery document. This file is the
// only place that knows the old names.
[
    Root = "/warp",
    Protocol = "warp-sql"
]
