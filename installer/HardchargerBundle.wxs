<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Hardcharger Power BI Connector"
           Manufacturer="GizmoData LLC"
           Version="$(var.ProductVersion)"
           UpgradeCode="D7F4B2AA-139E-49D1-8AA4-C575F690CFB7"
           Scope="perMachine">

    <Icon Id="hardcharger.ico" SourceFile="hardcharger.ico" />
    <Property Id="ARPPRODUCTICON" Value="hardcharger.ico" />

    <Property Id="EXISTINGTRUSTEDCERTIFICATES" Secure="yes">
      <RegistrySearch Id="FindTrustedCertificates" Root="HKLM"
          Key="SOFTWARE\Policies\Microsoft\Power BI Desktop"
          Name="TrustedCertificateThumbprints" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="OWNEDTRUSTEDCERTIFICATE" Secure="yes">
      <RegistrySearch Id="FindOwnedCertificate" Root="HKLM"
          Key="SOFTWARE\GizmoData\Hardcharger Power BI Connector"
          Name="ManagedCertificateThumbprint" Type="raw" Bitness="always64" />
    </Property>

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Hardcharger Power BI Connector is already installed." />

    <Media Id="1" Cabinet="hardcharger.cab" EmbedCab="yes" />

    <!-- Banner and dialog images -->
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <Feature Id="ProductFeature" Title="Hardcharger Power BI Connector" Level="1">
      <ComponentGroupRef Id="DriverComponents" />
      <ComponentGroupRef Id="ConnectorComponents" />
      <ComponentGroupRef Id="PowerBITrustComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="PowerBIFolder" Name="Microsoft Power BI Desktop">
        <Directory Id="PowerBIBinFolder" Name="bin">
          <Directory Id="PowerBIAdbcFolder" Name="ADBC Drivers">
            <Directory Id="INSTALLFOLDER" Name="Hardcharger" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <!-- Support both conventional custom connector Documents paths. Native
         driver installation requires the standalone Desktop host. -->
    <StandardDirectory Id="PersonalFolder">
      <Directory Id="PowerBIStoreDir" Name="Power BI Desktop">
        <Directory Id="CustomConnectorsStoreDir" Name="Custom Connectors" />
      </Directory>
      <Directory Id="PowerBIDesktopDir" Name="Microsoft Power BI Desktop">
        <Directory Id="CustomConnectorsDesktopDir" Name="Custom Connectors" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <!-- Current Power Query resolves Folder/File below its own ADBC Drivers
       directory. PATH is not consulted. INSTALLFOLDER can be overridden for a
       nondefault standalone Desktop or gateway binary directory. -->
  <Fragment>
    <ComponentGroup Id="DriverComponents" Directory="INSTALLFOLDER">
      <Component Id="AdbcHardchargerDll" Guid="B0C0AB27-38C0-4E6C-9BB6-D7F4CFC45677">
        <File Id="ConnectorThirdPartyNotices" Source="THIRD_PARTY_NOTICES.md" />
        <File Id="DriverThirdPartyNotices" Source="!(bindpath.BinDir)\THIRD_PARTY_NOTICES" />
        <File Id="DriverLicense" Source="!(bindpath.BinDir)\LICENSE" />
        <File Id="LibAdbcDriverHardchargerDll"
              Source="!(bindpath.BinDir)\libadbc_driver_hardcharger.dll"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Power BI trusted connector registry — allows signed .pqx to load
         at the default "Recommended" security level without user intervention.
         See: https://learn.microsoft.com/en-us/power-bi/connect-data/desktop-trusted-third-party-connectors -->
    <ComponentGroup Id="PowerBITrustComponents" Directory="INSTALLFOLDER">
      <Component Id="PowerBITrustedThumbprint" Guid="E3591AE7-BF08-421F-9664-B9261AA325EE"
          Condition='OWNEDTRUSTEDCERTIFICATE = "$(var.CertThumbprint)" OR NOT (EXISTINGTRUSTEDCERTIFICATES ~&gt;&lt; "$(var.CertThumbprint)")'>
        <!-- Never take ownership of trust already installed by GizmoSQL or an
             administrator. The marker retains ownership through upgrades. -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\GizmoData\Hardcharger Power BI Connector"
            Name="ManagedCertificateThumbprint" Type="string" Value="$(var.CertThumbprint)" KeyPath="yes" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\Microsoft\Power BI Desktop">
          <RegistryValue Name="TrustedCertificateThumbprints" Type="multiString"
                         Value="$(var.CertThumbprint)" Action="append" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- Power BI connector — install to both Documents naming conventions -->
    <ComponentGroup Id="ConnectorComponents">
      <Component Id="ConnectorPqxStore" Guid="74DB7944-2F2A-4238-B1FD-EE452CC3CB6D"
                 Directory="CustomConnectorsStoreDir">
        <RegistryValue Root="HKCU" Key="Software\GizmoData\Hardcharger Power BI Connector"
            Name="StoreConnector" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveStoreConnectorFolder" On="uninstall" />
        <RemoveFolder Id="RemoveStoreParentFolder" Directory="PowerBIStoreDir" On="uninstall" />
        <File Id="HardchargerPqxStore"
              Source="!(bindpath.ConnectorDir)\Hardcharger.pqx" />
      </Component>
      <Component Id="ConnectorPqxDesktop" Guid="999DA53B-ACC8-4896-83B7-F1666735DC6E"
                 Directory="CustomConnectorsDesktopDir">
        <RegistryValue Root="HKCU" Key="Software\GizmoData\Hardcharger Power BI Connector"
            Name="DesktopConnector" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveDesktopConnectorFolder" On="uninstall" />
        <RemoveFolder Id="RemoveDesktopParentFolder" Directory="PowerBIDesktopDir" On="uninstall" />
        <File Id="HardchargerPqxDesktop"
              Source="!(bindpath.ConnectorDir)\Hardcharger.pqx" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
